PORT=3000

# Feature mode controls
FEATURE_MODE=commercial
EDU_FEATURE_ENABLED=false
EDU_JWT_SECRET=replace-with-long-random-secret
EDU_JWT_EXPIRES_IN=12h
SQLITE_BUSY_TIMEOUT_MS=5000

# Admin bearer secret for license admin APIs
ADMIN_SECRET=your-super-secret-key-change-this

# CORS origins (comma separated)
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# Webhook secret
WEBHOOK_SECRET=your-webhook-secret

# Product mapping
PRODUCT_PERSONAL_IDS=personal_product_id_1,personal_product_id_2
PRODUCT_TEACHER_IDS=teacher_product_id_1,teacher_product_id_2

# Device limits
MAX_DEVICES_PERSONAL=1
MAX_DEVICES_TEACHER=3

# SQLite path
DB_PATH=./db/licenses.db

# Seed defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_DISPLAY_NAME=System Admin
SEED_TEACHER_USERNAME=teacher
SEED_TEACHER_PASSWORD=teacher@123
SEED_TEACHER_DISPLAY_NAME=Demo Teacher
